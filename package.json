{
  "name": "hakawi",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "packages/shared-types"
  ],
  "scripts": {
    "dev": "node scripts/check-dev-ports.mjs && concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run start:dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend -- --port 3000",
    "check:dev-ports": "node scripts/check-dev-ports.mjs",
    "build": "npm run build:shared-types && npm run build --workspace=backend && npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "typecheck": "npm run typecheck --workspace=backend && npm run typecheck --workspace=frontend",
    "build:shared-types": "npm run build --workspace=packages/shared-types",
    "db:check": "npm run db:check --workspace=backend",
    "migration:run": "npm run migration:run --workspace=backend",
    "migration:verify": "npm run migration:verify --workspace=backend",
    "migration:status": "npm run migration:status --workspace=backend",
    "seed:dev": "npm run seed:dev --workspace=backend",
    "seed:test": "npm run seed:test --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/testing": "^12.1.0",
    "next": "^16.4.2"
  },
  "overrides": {
    "undici": "^8.11.2",
    "ip-address": "^10.7.4",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2"
  }
}
