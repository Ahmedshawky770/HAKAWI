{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "incremental": false,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "seeds/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.config.e2e.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage", "playwright-report", "test-results"]
}
