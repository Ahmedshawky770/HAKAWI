{
  "name": "backend",
  "version": "0.0.1",
  "description": "Hakawi Backend API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint src/ --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:unit": "vitest run src/**/*.spec.ts",
    "test:integration": "vitest run --config ./vitest.config.e2e.ts",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e:playwright": "playwright test",
    "db:generate": "drizzle-kit generate:pg",
    "db:push": "drizzle-kit up:pg",
    "db:studio": "drizzle-kit studio",
    "db:seed:dev": "npm run seed:dev",
    "db:seed:test": "npm run seed:test",
    "seed:dev": "tsx seeds/dev.seed.ts",
    "seed:test": "tsx seeds/test.seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@nestjs/common": "^12.0.5",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.5",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.0.5",
    "@nestjs/platform-socket.io": "^12.0.5",
    "@nestjs/throttler": "^6.7.0",
    "@nestjs/websockets": "^12.0.5",
    "@paralleldrive/cuid2": "^3.3.0",
    "@sanity/client": "^7.27.0",
    "@socket.io/redis-adapter": "^8.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.29.3",
    "eventemitter2": "^6.4.9",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.3",
    "passport-facebook": "^3.0.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "tsx": "^4.23.15",
    "winston": "^3.17.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.5",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@swc/core": "^1.16.2",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/passport-oauth2": "^1.8.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "playwright": "^1.55.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.1"
  }
}
