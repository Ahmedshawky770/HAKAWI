# ============================================================================
# Every variable below is read by backend/src or backend/scripts. Where a
# variable is parsed but NOT enforced, or reserved for a feature that does not
# exist yet, the comment says so in capitals rather than leaving it to be
# discovered in production (Principle #4 — document the problem).
#
# Names here match the names the code reads. They are the source of truth for
# the *variable names*; where a documented name and a read name disagreed, the
# example file was the thing that was wrong and was corrected.
# ============================================================================

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hakawi
DB_USER=postgres
DB_PASSWORD=changeme

# Valkey (cache, throttler storage, Socket.IO adapter)
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=

# REDIS_HOST / REDIS_PORT / REDIS_PASSWORD — legacy aliases. `buildValkeyConnection`
# (src/config/valkey.config.ts) resolves VALKEY_* first and falls back to these, so the
# cache and the Socket.IO adapter can never end up pointed at different instances.
#
# THIS COMMENT USED TO SAY THE OPPOSITE, and the difference was a real bug: it claimed
# src/redis-io.adapter.ts read REDIS_* only, with no VALKEY_* fallback, so a Docker Compose
# deployment pointing websocket fan-out at localhost while the cache connected correctly.
# Single-instance deployments did not notice; multi-instance ones silently stopped fanning
# events out between them. The adapter now reads `valkey.host/port/password` through
# ConfigService, the same resolved values the cache uses. Prefer the VALKEY_* block above;
# set these only if something outside this repository still speaks the old names.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
# Both secrets must be a unique value of at least 32 characters. In production the built-in
# development fallbacks and the placeholders below are refused at boot: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-key-here-change-in-production
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret-here-change-in-production
REFRESH_TOKEN_EXPIRY=7d

# Encrypts password-reset tokens (auth.service.ts encrypts on request, decrypts on redemption).
# The placeholder below ships in this repository, so it is public, and in production the boot is
# refused with it — src/config/encryption.config.ts applies the same "publicly known value" rule as
# jwt.config.ts, from one shared list (src/config/public-secret.ts). Unlike the JWT secrets it has no
# minimum length: scrypt stretches whatever it is given, so any unique value works.
# NOTE: this key is NOT rotatable. The scrypt salt is a constant and is not stored in the ciphertext
# (the wire format is iv|body|authTag), so changing this value makes existing reset tokens
# undecryptable with no way to migrate them.
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# OAuth
# FRONTEND_URL is where auth.controller.ts sends the browser after the provider redirects back —
# the success landing page and every failure page. Unset means http://localhost:3000.
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret
# Facebook reads APP_ID / APP_SECRET, not CLIENT_ID / CLIENT_SECRET. TikTok reads CLIENT_KEY, not
# CLIENT_ID — TikTok's own parameter is `client_key`. These were previously documented here under the
# CLIENT_* names, which no line of code reads, so an operator who followed this file got an empty
# client id and sign-in failed with no error naming the missing value.
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# ⚠️ REQUIRED IN PRODUCTION — EVERY PROVIDER BREAKS SILENTLY WITHOUT THEM.
# These must match the redirect URIs registered with each provider EXACTLY, and each value is also
# the `redirect_uri` sent to the provider. auth.service.ts falls back to
# http://localhost:3001/api/v1/auth/oauth/<provider>/callback for all five when the variable is
# unset, which in production means the authorisation code is posted to localhost — where nothing is
# listening. The provider reports a redirect_uri_mismatch, or the browser gets a connection error,
# and nothing in this file or in the log names a variable the operator never set.
GOOGLE_CALLBACK_URL=https://api.example.com/api/v1/auth/oauth/google/callback
FACEBOOK_CALLBACK_URL=https://api.example.com/api/v1/auth/oauth/facebook/callback
GITHUB_CALLBACK_URL=https://api.example.com/api/v1/auth/oauth/github/callback
APPLE_CALLBACK_URL=https://api.example.com/api/v1/auth/oauth/apple/callback
TIKTOK_CALLBACK_URL=https://api.example.com/api/v1/auth/oauth/tiktok/callback

# Paymob
# PAYMOB_ENVIRONMENT picks the credential set: sandbox (default) or live.
# Sandbox and live share the same regional base URL; the keys and integration id are what differ.
PAYMOB_ENVIRONMENT=sandbox
PAYMOB_API_KEY=your-paymob-api-key
PAYMOB_MERCHANT_ID=your-merchant-id
PAYMOB_INTEGRATION_ID=your-integration-id
PAYMOB_WEBHOOK_SECRET=your-webhook-secret
PAYMOB_BASE_URL=https://accept.paymob.com/api
# Optional: used only when PAYMOB_ENVIRONMENT=sandbox, so a sandbox checkout can never charge a real card.
# LEFT COMMENTED OUT ON PURPOSE. paymob.config.ts declares these as `z.string().min(1).optional()`,
# and an empty value is not "absent" to Zod — it is a zero-length string that fails min(1). So
# `PAYMOB_SANDBOX_API_KEY=` written here uncommented makes the whole Paymob config fail at boot, and
# Zod's default message ("String must contain at least 1 character(s)") names neither variable. Copy
# this file verbatim and the API does not start.
# PAYMOB_SANDBOX_API_KEY=
# PAYMOB_SANDBOX_INTEGRATION_ID=
PAYMOB_REQUEST_TIMEOUT_MS=10000
PAYMOB_AUTH_TIMEOUT_MS=8000
# Must stay below Paymob's 3600s auth token lifetime; the runner clamps anything larger.
PAYMOB_AUTH_TOKEN_CACHE_TTL_SECONDS=3000
PAYMOB_RETRY_MAX_ATTEMPTS=2

# Email
# ⚠️ NOT READ BY ANY CODE. There is no SMTP client in this repository: email delivery is not built,
# and EMAIL_FROM (notifications-email.service.ts) is the only email variable the code reads. The
# five variables below are kept, and marked, so an operator who set them is not left believing mail
# is being sent — and so the intended surface is on record for when a transport lands.
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=noreply@hakawi.com

# Storage (S3)
STORAGE_BUCKET=hakawi-media
STORAGE_CDN_URL=
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_PDF_TYPES=application/pdf
# ⚠️ NOT READ BY ANY CODE. The S3 client is injected (upload.module.ts), so credentials come from the
# ambient AWS SDK chain — the instance role, ~/.aws/credentials, or AWS_* variables — and none of
# these four are consulted. STORAGE_REGION in particular does NOT set the client's region.
STORAGE_PROVIDER=s3
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key

# Sanity CMS
# PostgreSQL stays authoritative for story content; Sanity is a downstream read-only mirror.
SANITY_PROJECT_ID=your-sanity-project-id
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_TOKEN=your-sanity-token

# Sentry
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=development            # development | staging | production
SENTRY_TRACES_SAMPLE_RATE=1.0             # 0.1 in production, 1.0 in dev
SENTRY_RELEASE=                            # Optional: release tag or commit SHA

# App
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
# Swagger is served unless this is exactly "false". Turn it off in production.
ENABLE_SWAGGER=true
# ⚠️ NOT READ BY ANY CODE. Migrations are applied by an explicit command (npm run migration:run),
# never implicitly at boot, which is deliberate: an application that migrates its own schema on
# start-up cannot be rolled back independently of the release.
RUN_MIGRATIONS=true

# WAF (docs/deployment/environment.md#waf)
WAF_ENABLED=true
WAF_LOG_VIOLATIONS=true
WAF_BLOCK_ON_VIOLATION=true
WAF_FAIL_MODE=open                      # open | closed
WAF_BLOCK_SEVERITY=high                 # low | medium | high | critical
WAF_DISABLED_RULES=                     # CSV of rule ids from src/common/waf/rules.ts
WAF_MAX_REQUEST_SIZE=10485760           # 10MB
WAF_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS,HEAD
WAF_TEMP_BLOCK_SECONDS=3600             # temporary IP block duration
WAF_VIOLATION_WINDOW_SECONDS=900        # rolling window for the violation counter
WAF_VIOLATIONS_BEFORE_TEMP_BLOCK=5
WAF_VIOLATIONS_BEFORE_PERMANENT_BLOCK=25
WAF_STRICT_REFERRER=false
WAF_FINGERPRINT_PROTECTION=false
WAF_BLOCKED_COUNTRIES=                   # reserved: geo-blocking is not implemented yet
# Opt-in for the `header-forbidden-forwarding-headers` rule, OFF by default. Read it as: only turn
# it on when the app is directly reachable, or when the ingress STRIPS those headers from the
# client. Behind a proxy that forwards them, this 403s every request and blocks the deployment's
# own IP (see the rule's comment in src/config/waf.config.ts).
WAF_BLOCK_FORWARDING_HEADERS=false
# ⚠️ WAF_ADMIN_EMAIL IS NOT READ BY ANY CODE. It configures admin operations endpoints
# (GET /admin/waf/blocked-ips, POST /admin/waf/unblock-ip, POST /admin/waf/clear-counters,
# POST /admin/waf/clear-blocks) that are NOT BUILT. Until they are, an operator blocked by the WAF
# has no supported way out except direct Valkey manipulation.
WAF_ADMIN_EMAIL=admin@hakawi.com
# ⚠️ WAF_STRICT_REFERRER AND WAF_FINGERPRINT_PROTECTION ARE NOT READ BY ANY CODE. No rule declares
# either control; there is no referrer allowlist and no browser-fingerprint check. They are inert.

# Rate limiting (docs/api-contract/openapi/rest-api-spec.md#rate-limiting)
# Storage is Valkey (see src/common/throttler/valkey-throttler.storage.ts), so the
# limits are shared by every instance behind the load balancer.
# Tier selection happens with @ThrottleTier('auth' | 'session' | 'upload' | 'search').
# The `default` tier is what every route WITHOUT @ThrottleTier falls back to.
THROTTLE_DEFAULT_TTL=60000
THROTTLE_DEFAULT_LIMIT=30            # per IP — see the comment on THROTTLE_TIERS.default
THROTTLE_AUTH_TTL=60000
THROTTLE_AUTH_LIMIT=10               # per IP
# Token refresh and session endpoints, per IP. Deliberately loose and non-blocking: the browser
# fires one refresh per page load, so a tight budget logs out everyone behind an office NAT.
THROTTLE_SESSION_TTL=60000
THROTTLE_SESSION_LIMIT=120
THROTTLE_UPLOAD_TTL=60000
THROTTLE_UPLOAD_LIMIT=5              # per user
THROTTLE_SEARCH_TTL=60000
THROTTLE_SEARCH_LIMIT=50             # per user
THROTTLE_BLOCK_DURATION=0
# Behind a reverse proxy this must be true, or per-IP throttling and IP blocking key on the
# PROXY's address. The WAF reads the same flag on purpose: two components disagreeing about whether
# X-Forwarded-For is attacker-controllable is worse than either answer alone (Principle #9).
THROTTLE_TRUST_PROXY=false
# Escape hatch: if THROTTLE_TTL or THROTTLE_LIMIT is set, it replaces the limit/window of EVERY tier.
# Leave both UNSET in production and configure the per-tier variables above.
# Setting either one WITHOUT the acknowledgement below is REFUSED and logged, and the per-tier
# limits stay in force — otherwise a stray variable would silently disable rate limiting.
THROTTLE_ALLOW_GLOBAL_OVERRIDE=false
# vitest.config.e2e.ts sets THROTTLE_LIMIT=100000 with THROTTLE_ALLOW_GLOBAL_OVERRIDE=true to
# switch throttling off for the suite.
# THROTTLE_TTL=
# THROTTLE_LIMIT=

# Cache
# ⚠️ NONE OF THE VARIABLES BELOW ARE READ BY ANY CODE. TTLs are compile-time constants, not
# configuration: DEFAULT_CACHE_TTL_SECONDS = 3600 (cache.decorator.ts), and per-entity TTLs beside
# it (STORY_CACHE_TTL_SECONDS = 600, USER_CACHE_TTL_SECONDS = 300, PAYMENT_CACHE_TTL_SECONDS =
# 300, …). Setting these has no effect. They are marked rather than deleted so an operator who set
# them is not left believing cache behaviour is tuned.
CACHE_ENABLED=true
CACHE_TTL_DEFAULT=3600
CACHE_TTL_USER=1800
CACHE_TTL_STORY=3600
CACHE_TTL_NOTIFICATION=300

# Resilience (src/common/resilience/**)
# Shared by every circuit breaker, retry policy and timeout wrapper in the process.
DEFAULT_OPERATION_TIMEOUT_MS=5000
RETRY_MAX_RETRIES=3
RETRY_INITIAL_DELAY_MS=1000
RETRY_MAX_DELAY_MS=10000
RETRY_BACKOFF_MULTIPLIER=2
RETRY_JITTER_MS=500
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_MS=30000
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3
CIRCUIT_BREAKER_MONITORING_PERIOD_MS=60000

# Migration tooling (backend/scripts/{check,generate}-migration.ts, npm run db:check)
# Defaults to ../migrations when UNSET. Left commented out for the same reason as the Paymob sandbox
# keys: the script reads it with `??`, which falls back only on undefined, so `HAKAWI_MIGRATIONS_DIR=`
# would be used as the literal directory name "" instead of the default.
# HAKAWI_MIGRATIONS_DIR=